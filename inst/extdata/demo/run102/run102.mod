; SYNTHETIC DEMO ONLY: this control stream was not executed by NONMEM.
$PROBLEM Synthetic oral PK review fixture 102
$INPUT ROW ID TIME DV AMT EVID MDV DOSEGRP SEX WT OUTMAG
$DATA synthetic_data.csv IGNORE=@
$SUBROUTINES ADVAN2 TRANS2
$PK
CL = THETA(1)*EXP(ETA(1))
V = THETA(2)*EXP(ETA(2))
KA = THETA(3)
$ERROR
IPRED = PRED*(1+THETA(4)*OUTMAG)
W = THETA(5)*PRED
Y = IPRED + W*EPS(1)
$THETA (0,5.30) ; CL (L/h)
$THETA (0,50.0) ; V (L)
$THETA (0,1.20) ; KA (1/h)
$THETA (0,0.90) ; synthetic OUTMAG correction (demo only)
$THETA (0,0.15) ; proportional residual error
$OMEGA 0.0324
$OMEGA 0.0400
$SIGMA 1 FIX
$ESTIMATION METHOD=1 INTERACTION MAXEVAL=9999 PRINT=5 NOABORT
$COVARIANCE PRINT=E
$TABLE ROW ID TIME DV PRED IPRED CWRES EVID MDV AMT RATE CMT IWRES WRES OUTMAG DOSEGRP SEX WT ETA(1) ONEHEADER NOPRINT FILE=sdtab102
